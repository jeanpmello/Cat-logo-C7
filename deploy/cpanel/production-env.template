# Copie para o ambiente da aplicação Node.js no cPanel.
# Nunca publique este arquivo com valores reais no GitHub.
NODE_ENV=production
PORT=3000

# Banco MySQL/TiDB de produção
DATABASE_URL=mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO

# Sessão e autenticação Manus OAuth
